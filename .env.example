API_KEY=

# Firecrawl (product-page reading). Paste your key after the = sign. Leave empty until you have one.
FIRECRAWL_API_KEY=

# Optional: where the product-evidence cache is stored (default: .cache/evidence.sqlite3)
QUICKSHOP_EVIDENCE_CACHE=

# Optional: set to 1 to serve evidence only from the cache and never call Firecrawl (reproducible evaluation)
QUICKSHOP_EVIDENCE_REPLAY=
